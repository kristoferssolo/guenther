  "query": "\n        SELECT\n            id,\n            chat_id,\n            slug,\n            name,\n            description,\n            center_text,\n            state,\n            is_default AS `is_default: bool`\n        FROM\n            bingo_games\n        WHERE\n            chat_id = ?1\n            AND (\n                slug = ?2 COLLATE NOCASE\n                OR (\n                    ?2 IS NULL\n                    AND is_default = 1\n                )\n            )\n        ",
