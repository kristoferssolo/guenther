  "query": "\n        SELECT\n            c.id AS card_id,\n            c.user_id,\n            c.owner_name,\n            c.bingo_announced AS `bingo_announced: bool`,\n            g.id AS game_id,\n            g.chat_id,\n            g.slug,\n            g.name AS game_name,\n            g.description,\n            g.center_text,\n            g.state,\n            g.is_default AS `is_default: bool`\n        FROM\n            bingo_cards c\n            JOIN bingo_games g ON g.id = c.game_id\n        WHERE\n            c.id = ?\n        ",
