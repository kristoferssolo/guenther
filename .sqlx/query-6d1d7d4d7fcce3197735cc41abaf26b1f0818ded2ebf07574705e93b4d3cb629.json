  "query": "\n            INSERT INTO\n                bingo_games (chat_id, slug, name, is_default, created_by)\n            VALUES\n                (\n                    ?1,\n                    ?2,\n                    ?3,\n                    NOT EXISTS (\n                        SELECT\n                            1\n                        FROM\n                            bingo_games\n                        WHERE\n                            chat_id = ?1\n                            AND is_default = 1\n                    ),\n                    ?4\n                )\n            RETURNING\n                id,\n                chat_id,\n                slug,\n                name,\n                description,\n                center_text,\n                state,\n                is_default AS `is_default: bool`\n            ",
